# Copie para .env (que é ignorado pelo git) e ajuste os valores.
# O start-all.sh carrega o .env automaticamente.

# Chave HMAC usada para assinar (auth-service) e validar (gateway-service) o JWT.
# Precisa ser idêntica nos dois e ter pelo menos 32 caracteres.
JWT_SECRET=troque-por-uma-chave-bem-longa-e-secreta-com-32+-caracteres

# Senha do admin inicial (usuário TonhoDevi), usada só na primeira subida do
# auth-service, quando a tabela users está vazia.
ADMIN_DEFAULT_PASSWORD=troque-esta-senha

# Cookie do JWT: true em produção (HTTPS). Em dev (http://localhost) deixe false.
JWT_COOKIE_SECURE=false
